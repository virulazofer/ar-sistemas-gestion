APP_NAME="AR Sistemas - Gestión"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Desarrollo local (Etapa 1): SQLite por defecto.
# Producción / entorno destino: MySQL (descomentar y completar).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ar_sistemas_gestion
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@arsistemas.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Finanzas / DolarAPI
FINANCE_BASE_CURRENCY=ARS
FINANCE_QUOTE_CURRENCY=USD
DOLARAPI_BASE_URL=https://dolarapi.com/v1
DOLARAPI_OFFICIAL_PATH=/dolares/oficial
DOLARAPI_TIMEOUT=8
DOLARAPI_PREFERRED_FIELD=venta

# Primer administrador
# Staging/producción: php artisan app:create-admin  (NO uses seeder de admin)
# Local/testing: AdminUserSeeder solo corre en esos entornos; opcional:
# ADMIN_SEED_NAME=Administrador
# ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_EMAIL=admin@arsistemas.local
# ADMIN_SEED_PASSWORD=

# Tests MySQL opcionales (grupo `mysql`, NO corre en `php artisan test`)
# Ejecutar: php artisan test --group=mysql
# RUN_MYSQL_TESTS=1
# MYSQL_TEST_HOST=127.0.0.1
# MYSQL_TEST_PORT=3306
# MYSQL_TEST_DATABASE=ar_sistemas_test
# MYSQL_TEST_USERNAME=root
# MYSQL_TEST_PASSWORD=
