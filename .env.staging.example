APP_NAME="AR Sistemas - Gestión"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://ar.boscacci.com.ar

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MariaDB 11.x — usar driver mysql de Laravel
DB_CONNECTION=mysql
DB_HOST=192.168.0.60
DB_PORT=3306
DB_DATABASE=ff9469_ar_sistemas_staging
DB_USERNAME=ff9469_ferbos
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=ar.boscacci.com.ar
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@arsistemas.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Finanzas / DolarAPI (cotización oficial actual — venta)
FINANCE_BASE_CURRENCY=ARS
FINANCE_QUOTE_CURRENCY=USD
DOLARAPI_BASE_URL=https://dolarapi.com/v1
DOLARAPI_OFFICIAL_PATH=/dolares/oficial
DOLARAPI_TIMEOUT=8
DOLARAPI_PREFERRED_FIELD=venta
DOLARAPI_BUY_FIELD=compra

# Primer administrador (NO usar la contraseña de desarrollo).
# En staging/producción: php artisan app:create-admin
# Completar solo si algún proceso automatizado lo requiere; nunca versionar valores reales.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Scheduler (cron del hosting — configurar en etapa de deploy, no ahora):
# * * * * * cd /www/boscacci.com.ar/ar.boscacci.com.ar && php artisan schedule:run >> /dev/null 2>&1
# Comandos programados:
#   - exchange-rates:update  (hourly)
#   - subscriptions:generate (daily)
